{
  "name": "taiwan-dark-chess",
  "private": true,
  "version": "1.1.13",
  "type": "module",
  "license": "MIT",
  "author": "Will 保哥 (https://www.facebook.com/will.fans/)",
  "scripts": {
    "dev": "vite",
    "dev:server": "FIRESTORE_ENABLED=0 tsx watch server/index.ts",
    "build": "tsc && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --define:__APP_VERSION__=\"'$npm_package_version'\" --outfile=dist-server/index.mjs",
    "preview": "vite preview",
    "start": "node dist-server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p server"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "chart.js": "^4.5.1",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  }
}
